# Downstream consumer of the packed v2 skeleton packages
# Consumer references ONLY Vexel.Telegram.Handlers + Vexel.Telegram.Hosting.
# Immediate.Handlers is never referenced directly - it must arrive transitively.

$ cat Consumer.csproj
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Consumer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only Vexel packages referenced. Immediate.Handlers must arrive transitively. -->
    <PackageReference Include="Vexel.Telegram.Handlers" Version="0.0.0-preview.0.53" />
    <PackageReference Include="Vexel.Telegram.Hosting" Version="0.0.0-preview.0.53" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>
</Project>

$ cat Program.cs
using Immediate.Handlers.Shared;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using Vexel.Telegram.Hosting.Extensions;

// Proof that Immediate.Handlers flows transitively through Vexel.Telegram.Handlers
// (it is NOT referenced directly by this project).
Console.WriteLine($"[consumer] TFM                 : {System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription}");
Console.WriteLine($"[consumer] transitive attribute: {typeof(HandlerAttribute).AssemblyQualifiedName}");
Console.WriteLine($"[consumer] transitive interface: {typeof(IHandler<,>).FullName}");
Console.WriteLine();

var builder = Host.CreateApplicationBuilder();
builder.Logging.SetMinimumLevel(LogLevel.Information);
builder.Logging.AddSimpleConsole(o => o.SingleLine = true);

// The single public entry point a v2 consumer is meant to call.
builder.Services.AddTelegramService(
    tokenFactory: _ => "<redacted-test-bot-token>",
    configureClientOptions: o => o.DropPendingUpdates = false);

var host = builder.Build();

using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(2));
Console.WriteLine("[consumer] starting host...");
await host.RunAsync(cts.Token);
Console.WriteLine("[consumer] host stopped cleanly.");

